USE music_detail_app;

-- QUESTION 1: FULL JOIN Simulation (MySQL Workaround)
-- Note: MySQL does not support FULL JOIN directly, so we use LEFT JOIN + UNION + RIGHT JOIN
SELECT i.name AS influencer_name, c.collab_date 
FROM Influencers i
LEFT JOIN Collaborations c ON i.id = c.influencer1_id
UNION
SELECT i.name AS influencer_name, c.collab_date 
FROM Influencers i
RIGHT JOIN Collaborations c ON i.id = c.influencer1_id;

-- QUESTION 2: SELF JOIN for Nested Spotify Playlists
SELECT child.playlist_name AS SubPlaylist, parent.playlist_name AS ParentPlaylist
FROM Playlists child
LEFT JOIN Playlists parent ON child.parent_playlist_id = parent.id;

-- QUESTION 3: Multiple Chain JOINs (Flipkart-style 3 Table Connection)
SELECT u.username, o.order_date, p.amount 
FROM Users u
LEFT JOIN Orders o ON u.id = o.user_id
LEFT JOIN Payments p ON o.id = p.order_id;

-- QUESTION 4: Eliminating Zomato Review Duplicates
SELECT DISTINCT r.id, r.name, rev.review_text 
FROM Restaurants r
INNER JOIN Reviews rev ON r.id = rev.restaurant_id;

/* 
Explanation: Duplicates happen because a single restaurant has a One-to-Many 
relationship with reviews. One restaurant can have multiple customer review rows, 
forcing the restaurant name to print repeatedly unless DISTINCT or GROUP BY is used.
*/

-- QUESTION 5: Comparing Join Efficiencies (Products & Categories)
-- Condition A: Standard Relational Key Equivalence Join
SELECT p.product_name, c.category_name 
FROM Products p 
INNER JOIN Categories c ON p.category_id = c.id;

/* 
Efficiency Explanation: The standard INNER JOIN condition (Condition A) is 
significantly more efficient than using nested subquery loops. Modern relational 
query planners can evaluate table index trees all at once, rather than running 
iterative row-by-row lookups.
*/
