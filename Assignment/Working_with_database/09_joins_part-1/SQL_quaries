USE music_detail_app;

-- QUESTION 1: Create 'restaurants' and 'dishes' relational tables
CREATE TABLE restaurants (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100),
    city VARCHAR(100)
);

CREATE TABLE dishes (
    id INT AUTO_INCREMENT PRIMARY KEY,
    restaurant_id INT NOT NULL,
    dish_name VARCHAR(150),
    price DECIMAL(5,2)
);

