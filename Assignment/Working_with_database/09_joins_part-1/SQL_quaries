-- QUESTION 2: INNER JOIN to display each dish with restaurant name and city
SELECT d.dish_name, d.price, r.name AS restaurant_name, r.city
FROM dishes d
INNER JOIN restaurants r
ON d.restaurant_id = r.id;

-- QUESTION 3: LEFT JOIN to show all restaurants, including restaurants with no dishes
SELECT r.name AS restaurant_name, r.city, d.dish_name, d.price
FROM restaurants r
LEFT JOIN dishes d
ON r.id = d.restaurant_id;

-- QUESTION 4: RIGHT JOIN to show all dishes, including dishes with invalid restaurant_id
SELECT r.name AS restaurant_name, d.dish_name, d.price
FROM restaurants r
RIGHT JOIN dishes d
ON r.id = d.restaurant_id;

-- QUESTION 5: LEFT JOIN to show all playlists, even if some playlists are empty
SELECT p.playlist_name, s.song_name
FROM playlists p
LEFT JOIN songs s
ON p.playlist_id = s.playlist_id;

-- LEFT JOIN is used because it keeps every playlist from the left table,
-- even when there is no matching song in the songs table.
